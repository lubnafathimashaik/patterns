#include <iostream>
using namespace std;
int main()
{
    int rows = 5;

    // This loop for traverse pyramid from top to bottom
    for (int i = 0; i < rows; i++)
    {

        // Inner loop for printing character in each rows
        for (int j = 0; j <= i; j++)
        {
            cout<<j+1;
        }
        cout<<"\n";
    }
    return 0;
}

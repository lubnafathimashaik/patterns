#include <iostream>
#include<cstdio>
using namespace std;
int main()
{
    int rows = 5;

    // This loop for traverse pyramid from top to bottom
    for (int i = 0; i < rows; i++)
    {

        // Inner loop for printing character in each rows
        for (int j = 0; j <= i; j++)
        {
              printf("%c",'A'+j);
        }
        cout<<"\n";
    }
    return 0;
}
